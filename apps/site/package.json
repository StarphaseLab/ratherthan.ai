{
  "name": "site",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply ratherthan --local",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@ratherthan/detector": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@sveltejs/adapter-cloudflare": "^7.0.4",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.2.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.24.0"
  }
}
